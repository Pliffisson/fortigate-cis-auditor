# Traefik existente na VM: domínio interno e rede Docker compartilhada.
AUDITOR_DOMAIN=auditoria-fortinet.enw.internal
TRAEFIK_NETWORK=proxy
# Timezone IANA usado pelo dashboard, relatórios e logs do container.
TZ=America/Manaus
SESSION_COOKIE_SECURE=true

# Maximum HTTP upload size in MB, including multipart overhead.
MAX_UPLOAD_MB=10
# Optional HTTP Basic authentication. Enable both and publish only through HTTPS.
AUTH_USER=
AUTH_PASSWORD_HASH=
# Limite por cliente configurado no Traefik; evita agrupar clientes pelo IP do proxy.
REQUESTS_PER_MINUTE=0
